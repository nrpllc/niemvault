<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging for the operator CLI.

  Two streams, deliberately separated. Observability events (spec §4.7) are structured JSON, one
  object per line, and go to stdout so whatever collects container output can index them. Library
  chatter goes to stderr, so piping stdout to a file yields a clean event stream rather than a
  Parquet reader's internal commentary.

  Parquet, Hadoop, Avro and Flink are all extremely verbose at DEBUG, and Parquet logs a line per
  column page. Left at default they bury the events an operator is actually reading. Spec §9
  reserves unstructured logs for developer diagnostics, which is exactly what these are.
-->
<configuration>

  <appender name="EVENTS" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.out</target>
    <encoder>
      <!-- The event is already a complete JSON object; nothing is prefixed to it. -->
      <pattern>%msg%n</pattern>
    </encoder>
  </appender>

  <appender name="DIAGNOSTICS" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{HH:mm:ss} %-5level %logger{24} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Structured observability events. -->
  <logger name="gov.niemplatform.observability" level="INFO" additivity="false">
    <appender-ref ref="EVENTS"/>
  </logger>

  <!-- Storage and runtime libraries: warnings and above only. -->
  <logger name="org.apache.parquet" level="WARN"/>
  <!--
    Hadoop is on the classpath because Parquet's API signatures reference it, but no Hadoop
    filesystem is ever constructed (ADR 0005). Its Shell class still warns "Did not find
    winutils.exe" on Windows during static init, which is alarming, irrelevant, and the first
    thing an operator would chase. Silenced deliberately, not by accident.
  -->
  <logger name="org.apache.hadoop" level="ERROR"/>
  <logger name="org.apache.avro" level="WARN"/>
  <logger name="org.apache.flink" level="WARN"/>
  <!--
    A batch job that has finished shuts the MiniCluster down while the collect sink's coordinator is
    still trying to reach it, and the coordinator logs the resulting "MiniCluster is not yet running"
    with a full stack trace at WARN. The job has already produced its records: the trace is a
    shutdown race, not a failure.

    Silenced because the alternative is worse. An operator who sees a stack trace on every clean run
    learns that stack traces here mean nothing, and then misses the one that matters.
  -->
  <logger name="org.apache.flink.streaming.api.operators.collect" level="ERROR"/>
  <logger name="org.apache.iceberg" level="WARN"/>
  <logger name="software.amazon.awssdk" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="DIAGNOSTICS"/>
  </root>
</configuration>
